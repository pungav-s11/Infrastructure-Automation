---
- name: Update apt package index
  apt:
    update_cache: yes

- name: Upgrade installed packages
  apt:
    upgrade: dist
    force_apt_get: yes

- name: Install common packages
  apt:
    name:
      - curl
      - wget
      - unzip
      - git
      - vim
      - ca-certificates
      - software-properties-common
    state: present
    update_cache: yes